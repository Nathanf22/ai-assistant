# Copy this file to .env and fill in the values. Never commit .env.

# Bot token, from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Model used by the agent
LLM_MODEL=claude-sonnet-5-5

# Prices in USD per million tokens, used to estimate cost in /stats (leave 0 if unknown)
LLM_INPUT_USD_PER_MTOK=0
LLM_OUTPUT_USD_PER_MTOK=0
LLM_CACHE_READ_USD_PER_MTOK=0
LLM_CACHE_WRITE_USD_PER_MTOK=0

# Database: SQLite locally, PostgreSQL in production
DATABASE_URL=sqlite+aiosqlite:///./coach.db
# DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach

TIMEZONE=Europe/Paris

# Telegram user ids allowed to use /stats, comma-separated
ADMIN_TELEGRAM_IDS=

# Pilot invite codes (link t.me/<bot>?start=CODE). Empty = open sign-up.
PILOT_INVITE_CODES=

# Minutes after a session's planned end before asking for feedback
FEEDBACK_DELAY_MINUTES=45
