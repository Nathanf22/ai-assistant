# LOCAL DEVELOPMENT ONLY. Copy this file to .env and fill in the values. Never commit .env.
# Production variables live in Vercel, never in a local file: see .env.production.example.

# Token of your *local test* bot, from @BotFather (never the production bot: polling would
# remove the production webhook)
TELEGRAM_BOT_TOKEN=

# Anthropic API key (console.anthropic.com). Prefer a separate key from production.
ANTHROPIC_API_KEY=

# Model used by the agent
LLM_MODEL=claude-haiku-5-5

# Prices in USD per million tokens, used to estimate cost in /stats.
# Claude Haiku 5.5 rates for prompts up to 100K tokens; the cache write is the 5-minute TTL.
LLM_INPUT_USD_PER_MTOK=0.10
LLM_OUTPUT_USD_PER_MTOK=0.50
LLM_CACHE_READ_USD_PER_MTOK=0.01
LLM_CACHE_WRITE_USD_PER_MTOK=0.125

# Database: SQLite locally
DATABASE_URL=sqlite+aiosqlite:///./coach.db
# DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach

TIMEZONE=Europe/Paris

# Telegram user ids allowed to use /stats, comma-separated
ADMIN_TELEGRAM_IDS=

# Pilot invite codes (link t.me/<bot>?start=CODE). Empty = open sign-up.
PILOT_INVITE_CODES=

# Minutes after a session's planned end before asking for feedback
FEEDBACK_DELAY_MINUTES=45

# Leave empty locally: setting it switches to webhook (production) mode and refuses polling.
TELEGRAM_WEBHOOK_SECRET=
