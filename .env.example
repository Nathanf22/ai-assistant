# Copier ce fichier en .env et renseigner les valeurs. Ne jamais committer .env.

# Jeton du bot, obtenu auprès de @BotFather sur Telegram
TELEGRAM_BOT_TOKEN=

# Clé API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Modèle utilisé par l'agent
LLM_MODEL=claude-sonnet-5-5

# Tarifs en USD par million de tokens, pour estimer le coût dans /stats (laisser 0 si inconnus)
LLM_INPUT_USD_PER_MTOK=0
LLM_OUTPUT_USD_PER_MTOK=0
LLM_CACHE_READ_USD_PER_MTOK=0
LLM_CACHE_WRITE_USD_PER_MTOK=0

# Base de données : SQLite en local, PostgreSQL en production
DATABASE_URL=sqlite+aiosqlite:///./coach.db
# DATABASE_URL=postgresql+asyncpg://coach:coach@localhost:5432/coach

TIMEZONE=Europe/Paris

# Identifiants Telegram autorisés à utiliser /stats, séparés par des virgules
ADMIN_TELEGRAM_IDS=

# Codes d'invitation du pilote (lien t.me/<bot>?start=CODE). Vide = inscription libre.
PILOT_INVITE_CODES=

# Minutes après la fin prévue d'une séance avant de demander un retour
FEEDBACK_DELAY_MINUTES=45
