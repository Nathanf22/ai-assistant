# PRODUCTION (Vercel). Reference list only: DO NOT fill in this file.
# Set each variable in Vercel > Project > Settings > Environment Variables, scope "Production".

# Token of the *production* bot (a different bot from the local one)
TELEGRAM_BOT_TOKEN=

# Production Anthropic API key, with a spending limit set in the console
ANTHROPIC_API_KEY=

LLM_MODEL=claude-haiku-5-5
LLM_INPUT_USD_PER_MTOK=0.10
LLM_OUTPUT_USD_PER_MTOK=0.50
LLM_CACHE_READ_USD_PER_MTOK=0.01
LLM_CACHE_WRITE_USD_PER_MTOK=0.125

# Set by the Neon integration (Vercel > Storage). Plain postgres:// URLs with sslmode=require
# are accepted. Use the direct (non-pooled) connection string.
DATABASE_URL=

TIMEZONE=Europe/Paris
ADMIN_TELEGRAM_IDS=
PILOT_INVITE_CODES=
FEEDBACK_DELAY_MINUTES=45

# Random secrets, e.g. `openssl rand -hex 32` (one each)
# Checked on every Telegram update (X-Telegram-Bot-Api-Secret-Token header)
TELEGRAM_WEBHOOK_SECRET=
# Required as "Authorization: Bearer <CRON_SECRET>" by /api/tick and /api/set-webhook
CRON_SECRET=
